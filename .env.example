# The Android WebView uses this local origin. Add your HTTPS web origin if separate.
CORS_ORIGINS=https://localhost,http://localhost,http://localhost:5173
MAX_FILE_BYTES=209715200
MAX_JOBS=20
DOWNLOAD_WORKERS=2
FILE_TTL_SECONDS=1800
JOB_TIMEOUT_SECONDS=180
# Must fit within the /data tmpfs (1 GiB by default).
DISK_RESERVE_BYTES=134217728
RATE_LIMIT_PER_MINUTE=20
# Optional frontend build-time default server. Otherwise configure in app Settings.
# VITE_API_URL=https://save.example.com
